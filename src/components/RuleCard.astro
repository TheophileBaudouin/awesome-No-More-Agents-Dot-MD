---
import { EVENT_LABELS, ACTION_LABELS } from "../registry";

interface Props {
  slug: string;
  name: string;
  description: string;
  category: string;
  author: string;
  events: string[];
  action: string;
  searchText: string;
}

const { slug, name, description, category, author, events, action, searchText } =
  Astro.props;
const base = import.meta.env.BASE_URL;

const eventLabels = events.map((e) => EVENT_LABELS[e] ?? e).join(", ");
const actionLabel = ACTION_LABELS[action] ?? action;
---

<a
  class="rule-card"
  href={`${base}rules/${slug}/`}
  data-category={category}
  data-search={searchText}
>
  <div class="rule-card-top">
    <h3>{name}</h3>
    <span class="badge">{category}</span>
  </div>
  {description && <p class="rule-card-desc">{description}</p>}
  <div class="rule-card-meta">
    <span>@{author}</span>
    <span title={events.join(", ")}>{eventLabels}</span>
    <span class="action-label" title={action}>{actionLabel}</span>
  </div>
</a>
