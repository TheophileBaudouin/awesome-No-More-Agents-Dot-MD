---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../site-config";

const base = import.meta.env.BASE_URL;
const formUrl = `${siteConfig.repoUrl}/issues/new?template=submit.yml`;
const guideUrl = `${siteConfig.repoUrl}/blob/main/CONTRIBUTING.md`;
---

<BaseLayout
  title="Submit a context file"
  description="How to share a Pi context file with the community registry."
>
  <section class="container submit-page">
    <nav class="breadcrumb">
      <a href={base}>Registry</a>
      <span>/</span>
      <span>Submit</span>
    </nav>

    <h1>Submit a context file</h1>
    <p class="lead">
      Share a <code>.pi/context/</code> file with the community. Four steps,
      no Git needed.
    </p>

    <ol class="steps-grid">
      <li class="step-card">
        <span class="step-num" aria-hidden="true">1</span>
        <h2>Open the form</h2>
        <p>One click, right below.</p>
      </li>
      <li class="step-card">
        <span class="step-num" aria-hidden="true">2</span>
        <h2>Name your file</h2>
        <p>
          Kebab-case, like <code>conventional-commits</code>. Pick a category.
        </p>
      </li>
      <li class="step-card">
        <span class="step-num" aria-hidden="true">3</span>
        <h2>Paste the file</h2>
        <p>The whole context file, frontmatter included.</p>
      </li>
      <li class="step-card">
        <span class="step-num" aria-hidden="true">4</span>
        <h2>Submit</h2>
        <p>
          The bot validates it, opens a pull request, and a maintainer merges
          it.
        </p>
      </li>
    </ol>

    <p class="submit-note">
      You need a GitHub account. That is the only requirement.
    </p>

    <div class="submit-cta">
      <a
        class="btn btn-gradient-text"
        href={formUrl}
        data-label="Open the form"
      >
        Open the form
      </a>
      <a class="btn btn-outline" href={guideUrl}>Full guide</a>
    </div>
  </section>
</BaseLayout>
