---
import BaseLayout from "../layouts/BaseLayout.astro";
import RuleCard from "../components/RuleCard.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../site-config";
import { CATEGORIES } from "../registry";

const base = import.meta.env.BASE_URL;

const entries = await getCollection("registry");

const cards = entries.map((e) => {
  const rule = e.data.rule;
  const metadata = e.data.metadata;
  return {
    slug: e.id,
    name: rule.name,
    description: rule.description,
    category: metadata.category,
    author: metadata.author,
    events: rule.events,
    action: String(rule.action.type),
    searchText: [
      rule.name,
      rule.description,
      ...metadata.tags,
      metadata.author,
      metadata.category,
    ]
      .join(" ")
      .toLowerCase(),
  };
});

const countByCategory = (category: string) =>
  cards.filter((c) => c.category === category).length;
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <h1>Context files for Pi agents, shared by the community</h1>
      <p>
        Browse, share, and download community rules to drop into your
        .pi/context/ folder.
      </p>
      <div class="hero-actions">
        <a
          class="btn btn-gradient-text"
          href={`${base}submit/`}
          data-label="Submit a context file"
        >
          Submit a context file
        </a>
        <a
          class="btn btn-outline"
          href={`${siteConfig.repoUrl}/blob/main/CONTRIBUTING.md`}
        >
          Contribution guide
        </a>
        <span class="hero-downloads" id="download-line" hidden>
          <svg
            aria-hidden="true"
            viewBox="0 0 16 16"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              d="M8 2v8m0 0 3-3m-3 3L5 7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path d="M3 13h10" stroke-linecap="round" />
          </svg>
          <span id="download-count"></span>
          <span>extension downloads in the last 30 days</span>
        </span>
      </div>
    </div>
  </section>

  <section class="container">
    <div class="toolbar">
      <input
        id="search"
        type="search"
        placeholder="Search by name, description, tag, author…"
        autocomplete="off"
        aria-label="Search context files"
      />
      <fieldset class="chips-fieldset">
        <legend class="chips-legend">Filter by category</legend>
        <div class="chips" id="chips">
          <button
            class="chip active"
            data-category="all"
            type="button"
            aria-pressed="true"
          >
            All <span>({cards.length})</span>
          </button>
          {CATEGORIES.map((c) => (
            <button class="chip" data-category={c} type="button" aria-pressed="false">
              {c} <span>({countByCategory(c)})</span>
            </button>
          ))}
        </div>
      </fieldset>
    </div>

    <p id="count" class="count" aria-live="polite"></p>

    <div class="grid" id="grid">
      {cards.map((c) => (
        <RuleCard {...c} />
      ))}
    </div>

    <p id="empty" class="empty-state" role="status">
      No context files match your filters.
    </p>
  </section>

  <script is:inline>
    const search = document.getElementById("search");
    const chips = Array.from(document.querySelectorAll(".chip"));
    const cards = Array.from(document.querySelectorAll(".rule-card"));
    const count = document.getElementById("count");
    const empty = document.getElementById("empty");
    let activeCategory = "all";

    function apply() {
      const q = (search.value || "").toLowerCase().trim();
      let visible = 0;
      for (const card of cards) {
        const matchesSearch =
          !q || card.dataset.search.includes(q);
        const matchesCategory =
          activeCategory === "all" || card.dataset.category === activeCategory;
        const show = matchesSearch && matchesCategory;
        card.hidden = !show;
        if (show) visible++;
      }
      count.textContent = `${visible} of ${cards.length} context files`;
      empty.classList.toggle("visible", visible === 0);
    }

    search.addEventListener("input", apply);
    for (const chip of chips) {
      chip.addEventListener("click", () => {
        for (const c of chips) {
          const on = c === chip;
          c.classList.toggle("active", on);
          c.setAttribute("aria-pressed", String(on));
        }
        activeCategory = chip.dataset.category;
        apply();
      });
    }
    apply();
  </script>

  <script is:inline>
    // Discreet monthly download stat. Hidden until the API answers;
    // stays hidden on failure, so it never flashes or breaks the hero.
    (async () => {
      const line = document.getElementById("download-line");
      const count = document.getElementById("download-count");
      try {
        const res = await fetch(
          "https://api.npmjs.org/downloads/point/last-month/no-more-agents-dot-md"
        );
        const data = await res.json();
        if (data && typeof data.downloads === "number") {
          count.textContent = new Intl.NumberFormat("en-US").format(
            data.downloads
          );
          line.hidden = false;
        }
      } catch {
        /* leave hidden */
      }
    })();
  </script>
</BaseLayout>
