---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Giscus from "../../components/Giscus.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { siteConfig } from "../../site-config";
import { EVENT_LABELS, ACTION_LABELS } from "../../registry";

export async function getStaticPaths() {
  const entries = await getCollection("registry");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"registry">;
}

const { entry } = Astro.props;
const { rule, metadata } = entry.data;
const { Content } = await render(entry);

const blobUrl = `${siteConfig.repoUrl}/blob/main/registry/${entry.id}/context.md`;
const rawUrl = `${siteConfig.rawUrl}/registry/${entry.id}/context.md`;
const priorityLabel = ["low", "normal", "high"][rule.priority - 1] ?? "normal";
const base = import.meta.env.BASE_URL;

const eventLabels = rule.events.map((e) => EVENT_LABELS[e] ?? e);
const actionLabel = ACTION_LABELS[String(rule.action.type)] ?? String(rule.action.type);

/** Reinterpret simple `{ <event>: { contains: [...] } }` / regex matches as
 * a sentence; return null when the shape is anything more complex. */
function friendlyMatch(match: Record<string, unknown>): string | null {
	const keys = Object.keys(match);
	if (keys.length !== 1) return null;
	const cond = match[keys[0]];
	if (!cond || typeof cond !== "object") return null;
	const label = (EVENT_LABELS[keys[0]] ?? keys[0]).toLowerCase();
	const contains = (cond as Record<string, unknown>).contains;
	if (Array.isArray(contains) && contains.length > 0) {
		return `Only when the ${label} contains: ${contains.map(String).join(", ")}`;
	}
	const regex = (cond as Record<string, unknown>).regex;
	if (Array.isArray(regex) && regex.length > 0) {
		return `Only when the ${label} matches: ${regex.map(String).join(", ")}`;
	}
	return null;
}
const matchSentence = rule.match ? friendlyMatch(rule.match) : null;
---

<BaseLayout title={rule.name} description={rule.description}>
  <div class="container">
    <nav class="breadcrumb">
      <a href={base}>Registry</a>
      <span>/</span>
      <span>{rule.name}</span>
    </nav>

    <header class="rule-header">
      <h1>{rule.name}</h1>
      {rule.description && <p class="lead">{rule.description}</p>}
      <div class="badges">
        <span class="badge">{metadata.category}</span>
        {metadata.tags.map((t) => (
          <span class="badge badge-muted">{t}</span>
        ))}
      </div>
    </header>

    <div class="trigger-strip">
      <span class="trigger-events">
        <span class="connector">Triggers on</span>
        {eventLabels.map((l) => (
          <span class="event-tag">{l}</span>
        ))}
      </span>
      <span class="trigger-action">
        <span class="connector">and reacts by</span>
        <span class="action-tag">{actionLabel}</span>
      </span>
    </div>

    <dl class="meta-grid">
      <div>
        <dt>Author</dt>
        <dd>@{metadata.author}</dd>
      </div>
      <div>
        <dt>Priority</dt>
        <dd class={`priority ${priorityLabel}`}>{priorityLabel}</dd>
      </div>
      {metadata.minPiVersion && (
        <div>
          <dt>Min Pi version</dt>
          <dd class="mono">{metadata.minPiVersion}</dd>
        </div>
      )}
      {metadata.repo && (
        <div>
          <dt>Source</dt>
          <dd>
            <a href={metadata.repo} rel="noopener noreferrer">
              {metadata.repo.replace(/^https?:\/\//, "")}
            </a>
          </dd>
        </div>
      )}
    </dl>

    <div class="actions">
      <a class="btn" href={rawUrl}>
        Download context.md
      </a>
      <a class="btn btn-outline" href={blobUrl}>
        View on GitHub
      </a>
    </div>

    {matchSentence ? (
      <p class="match-fact">
        <strong>When it applies</strong>
        <span class="match-value">{matchSentence}</span>
      </p>
    ) : (
      rule.match && (
        <details class="match">
          <summary>Match condition</summary>
          <pre><code>{JSON.stringify(rule.match, null, 2)}</code></pre>
        </details>
      )
    )}

    <article class="prose">
      <h2>Context</h2>
      <div id="context-body" class="context-clamp">
        <Content />
      </div>
      <button
        id="context-toggle"
        class="context-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="context-body"
        hidden
      >
        Show more
      </button>
    </article>

    <section class="comments">
      <h2>Comments</h2>
      <Giscus />
    </section>
  </div>

  <script is:inline>
    const body = document.getElementById("context-body");
    const toggle = document.getElementById("context-toggle");
    if (body && toggle) {
      // Short content: no clamp, no button.
      toggle.hidden = body.scrollHeight <= body.clientHeight + 1;
      toggle.addEventListener("click", () => {
        const open = body.classList.toggle("is-expanded");
        toggle.setAttribute("aria-expanded", String(open));
        toggle.textContent = open ? "Show less" : "Show more";
      });
    }
  </script>
</BaseLayout>
